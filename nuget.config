<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- a package folder of this repo's own: the PC's shared ~/.nuget cache held an earlier build of 0.2.0-dev.28
         under the same version, and NuGet never refreshes a version it has cached -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
  <packageSources>
    <!-- the sdk/ folder of a Kiln release (https://github.com/frostdev-ops/kiln/releases), copied or linked here -->
    <add key="kiln-sdk" value="kiln-sdk" />
  </packageSources>
</configuration>
